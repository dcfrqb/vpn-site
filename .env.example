# Copy to .env on the server. Never commit real values.
COMPOSE_PROJECT_NAME=vpn-site

# ports on the host, bound to 127.0.0.1 only (see deploy/README.md)
WEB_PORT=3040
API_PORT=8040

# own database of the site (schema "web"), not the bot database
POSTGRES_DB=vpn_site
POSTGRES_USER=vpn_site
POSTGRES_PASSWORD=change-me

# auth
SESSION_SECRET=change-me
PUBLIC_ORIGIN=https://vpn.crs-projects.com
# local http dev: set a name without the __Host- prefix, e.g. sid
SESSION_COOKIE=__Host-sid
TELEGRAM_BOT_USERNAME=
TELEGRAM_LOGIN_BOT_TOKEN=
WEBAUTHN_RP_ID=vpn.crs-projects.com
WEBAUTHN_RP_NAME=CRS VPN
WEBAUTHN_ORIGIN=https://vpn.crs-projects.com

# mail; empty SMTP_HOST = letters stay in web.outbox (465 = SSL, else STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# payments (test shop until launch)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# cabinet data: bot internal API (ownership, plans, payments) + Remnawave panel (live data).
# Either URL empty = mock data with the "пример" badge.
BOT_API_URL=
BOT_API_TOKEN=
REMNAWAVE_API_URL=
# panel API token (Remnawave > API tokens), sent as Bearer
REMNAWAVE_API_TOKEN=
SUBSCRIPTION_BASE_URL=https://sub.crs-projects.com

# shared secret with @crs_vpn_bot for /api/internal/tg-login/*
SITE_INTERNAL_TOKEN=
